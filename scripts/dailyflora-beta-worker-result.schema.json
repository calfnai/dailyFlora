{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "flowers", "colors", "composition", "seed", "themeId", "renderParams"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "flowers": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "colors": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
    "composition": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "seed": { "type": "string", "minLength": 1, "maxLength": 180 },
    "themeId": { "type": "string", "enum": ["tropical-forest", "moon-white", "fairy-violet", "sea-salt-lemon", "hillside-wild", "summer-pinwheel", "dopamine-field", "starry-night", "dewberry-morning", "lychee-garden-rainbow", "her-january-sky", "her-january-sky-v2"] },
    "renderParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": { "type": "string", "enum": ["low", "medium", "high"] },
        "render": { "type": "string", "enum": ["low", "medium", "high"] },
        "spread": { "type": "number", "minimum": 0.6, "maximum": 1.5 },
        "height": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "airiness": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["density", "render", "spread", "height", "airiness"]
    }
  }
}
